def sumofsubarray(arr):
    mod = 10**9 + 7
    n = len(arr)
    prev_smaller = [-1] * n     # remove duplicates
    next_smaller = [n] * n      

    stack = []
    for i in range(n):
        while stack and arr[stack[-1]] > arr[i]:      # strict
            stack.pop()
        prev_smaller[i] = stack[-1] if stack else -1
        stack.append(i)

    stack = []
    for i in range(n - 1, -1, -1):
        while stack and arr[stack[-1]] >= arr[i]:      # non-strict 
            stack.pop()
        next_smaller[i] = stack[-1] if stack else n
        stack.append(i)

    total = 0
    for i in range(n):
        left = i - prev_smaller[i]      
        right = next_smaller[i] - i     
        total += arr[i] * left * right
    return total % mod
