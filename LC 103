class Solution:
    def zigzagLevelOrder(self, root: Optional[TreeNode]) -> List[List[int]]:
        if root is None:
            return []
        result = []
        current = [root]              
        left_to_right = True
        while current:
            level = []
            nxt = []                  
            while current:
                node = current.pop()   
                level.append(node.val)
                if left_to_right:
                    if node.left:
                        nxt.append(node.left)
                    if node.right: 
                        nxt.append(node.right)
                else:
                    if node.right: 
                        nxt.append(node.right)
                    if node.left:  
                        nxt.append(node.left)
            result.append(level)
            current = nxt
            left_to_right = not left_to_right
        return result
