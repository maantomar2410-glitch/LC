class ListNode:
     def __init__(self, val=0, next=None):
         self.val = val
         self.next = next
class Solution:
    def merge(self, first, second):
        dummy = ListNode(0)
        tail = dummy
        while first and second:
            if first.val >= second.val:
                tail.next = second
                second = second.next
            else:
                tail.next = first
                first = first.next
            tail = tail.next
        tail.next = first if first else second
        return dummy.next

    def mergeKLists(self, lists):
        if not lists:
            return None
        result = lists[0]
        for i in range(1, len(lists)):
            result = self.merge(result, lists[i])
        return result
