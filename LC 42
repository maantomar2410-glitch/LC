def trap(arr):
    stackdec=[]
    stackinc=[]
    start=len(arr)-1
    ans=0
    while(start>=0):
        if len(stackdec)==0:
            stackdec.append(arr[start])
            start-=1
        elif len(stackinc)>0 and stackinc[-1]>=stackdec[-1]:

            high=max(stackinc)
            for i in range(len(stackinc)):
                ans+=high-stackinc[i]
            stackinc.clear()
            stackinc.append(high)
            stackdec.clear()
            start-=1
        elif len(stackdec)>0 and arr[start]>stackdec[-1]:
            stackdec.append(arr[start])
            start-=1
        elif len(stackdec)>0 and arr[start]<=stackdec[-1]:
            stackinc.append(arr[start])
            start-=1
        print(ans)
    return ans
