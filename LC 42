def trap(arr):
    leftmax=[]
    rightmax=[]
    for i in range(len(arr)):
        if i==0:
            leftmax.append(arr[i])
        else:
            leftmax.append(max(leftmax[i-1],arr[i]))
    for i in range(len(arr)-1,-1,-1):
        if i==len(arr)-1:
            rightmax.append(arr[i])
        else:
            rightmax.append(max(rightmax[len(arr)-i-2],arr[i]))
    rightmax=rightmax[::-1]
    ans=0
    for i in range(len(arr)):
        check=min(leftmax[i],rightmax[i])
        if check>arr[i]:
            ans+=check-arr[i]
    return ans
